# Tavern settings. Copy this file to .env and fill it in:
#   cp .env.example .env

# The address your friends open (your Cloudflare Tunnel hostname), without a
# trailing slash. Invite links and password-reset emails point here.
PUBLIC_URL=https://tavern.example.com

# ---------------------------------------------------------------------------
# Cloudflare Tunnel
# ---------------------------------------------------------------------------
# Starts the tunnel container. Comment this out to run Tavern locally only.
COMPOSE_PROFILES=tunnel
# The token from Cloudflare Zero Trust > Networks > Tunnels > your tunnel.
TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Email for password resets (Gmail)
# ---------------------------------------------------------------------------
# SMTP_PASSWORD is a Gmail *app password*, not your normal password.
# Leave both blank and reset links are printed in the server log instead.
SMTP_USER=
SMTP_PASSWORD=
# Optional sender name shown in the inbox:
# SMTP_FROM=Tavern <you@gmail.com>
# Other providers: set the host/port. SMTP_SECURITY is starttls, ssl or none.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls

# ---------------------------------------------------------------------------
# Uploads and extras
# ---------------------------------------------------------------------------
# Total upload size per message, in MB. Cloudflare's free plan rejects
# requests over 100 MB, so stay a bit under that when using the tunnel.
MAX_UPLOAD_MB=95

# Link previews (YouTube, sites with OpenGraph tags). The server fetches the
# page to build them.
LINK_EMBEDS=true

# ---------------------------------------------------------------------------
# Voice spaces
# ---------------------------------------------------------------------------
# Voice and video go straight between players' browsers. Public STUN servers
# are used by default and are enough for most home networks. If some players
# can't hear each other (strict school/work/phone networks), add a TURN relay.
#
# Easiest: Cloudflare Realtime TURN (the first 1,000 GB each month are free).
# Create a TURN key at https://dash.cloudflare.com/?to=/:account/calls
# (Realtime > TURN), then paste its key ID and API token here:
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
#
# Or your own TURN server (e.g. coturn):
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
#
# STUN servers, comma separated (these are the defaults):
# STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# ---------------------------------------------------------------------------
# Jukebox
# ---------------------------------------------------------------------------
# Let DJs import songs from links (YouTube, SoundCloud, Bandcamp...) with yt-dlp.
JUKEBOX_URL_IMPORTS=true
# Biggest song file, in MB. Uploads through the Cloudflare Tunnel are also
# capped at 100 MB per upload; link imports download on the server so they
# aren't.
JUKEBOX_MAX_TRACK_MB=300
# Update yt-dlp every time the container starts (recommended: sites change).
YTDLP_AUTO_UPDATE=true
# Spotify links (optional). Make an app at https://developer.spotify.com/dashboard
# with the redirect URI <PUBLIC_URL>/api/spotify/callback, then paste its keys.
# Spotify requires Premium on the account that owns the app.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Theater
# ---------------------------------------------------------------------------
# YouTube videos play straight from YouTube in each person's browser, so they
# never pass through Tavern or the tunnel. Uploaded videos do: Cloudflare's
# free plan caps each upload at 100 MB, and its terms don't allow serving a
# lot of video through it, so stick to short clips when using the tunnel.
# Biggest video file, in MB.
THEATER_MAX_VIDEO_MB=500

# LOG_LEVEL=info
